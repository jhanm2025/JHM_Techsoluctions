# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — backend/.env
# =============================================================================
# Copia este archivo como ".env" (sin ".example") y completa tus propios
# valores. El archivo ".env" real NUNCA debe subirse a GitHub (ya está en
# .gitignore). Este archivo .env.example SÍ se sube, como referencia para
# quien clone el proyecto o lo despliegue en Railway/otra plataforma.
# =============================================================================

# Base de datos (local: mysql+pymysql://root:@localhost:3306/nombre_bd)
# En Railway, usa la variable que te entregue el plugin de MySQL/Postgres.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/bd_jhm_tech_solutions_fastapi

# Seguridad JWT
SECRET_KEY=cambia_esta_clave_por_una_aleatoria_y_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# Usuario administrador creado automáticamente al iniciar la API
ADMIN_EMAIL=admin@jhmtechsolutions.com
ADMIN_PASSWORD=Admin123!
ADMIN_DOCUMENTO=1000000000

# URL pública del frontend (para enlaces de recuperación de contraseña y CORS)
FRONTEND_URL=http://localhost:5173

# Envío de correo (recuperación de contraseña, notificaciones).
# Si se deja vacío, el sistema funciona en modo desarrollo (imprime el
# correo en consola en lugar de enviarlo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@jhmtechsolutions.com
SMTP_FROM_NAME=JHM Tech Solutions

# Chatbot con Inteligencia Artificial (OpenAI API).
# Consigue tu clave en https://platform.openai.com/api-keys
# NUNCA subas tu clave real a GitHub. Si se deja vacía, el chatbot
# funciona con un motor de respuestas basado en reglas (modo demo).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
