# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — frontend/.env
# =============================================================================
# Copia este archivo como ".env" (sin ".example") y ajusta la URL según tu
# entorno. En Vite, todas las variables deben empezar con "VITE_" para
# quedar disponibles en el código del navegador.
# =============================================================================

# URL base de la API del backend.
# Local:      http://127.0.0.1:8000
# Producción: https://tu-backend.up.railway.app  (sin "/" al final)
VITE_API_URL=http://127.0.0.1:8000
